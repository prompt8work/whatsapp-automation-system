{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,src/app/**/tests/**,alembic/**,.venv/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.py"
    }
  ],
  "crons": [
    {
      "path": "/internal/jobs/tick",
      "schedule": "* * * * *"
    }
  ]
}
