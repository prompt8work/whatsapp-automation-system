# Copy to backend/.env for local development. On Vercel set these as Environment Variables.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Runtime: role app_rw. In production use the POOLED connection string.
DATABASE_URL=postgresql+psycopg://app_rw:app_rw@localhost:5432/wa_platform
# Migrations: role app_owner. In production use the DIRECT (non-pooled) connection string.
DATABASE_MIGRATION_URL=postgresql+psycopg://app_owner:app_owner@localhost:5432/wa_platform

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required outside local/test (the app refuses to start with the defaults).
JWT_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]

# WhatsApp. Locally keep "recording" (replies are logged / shown by `cli simulate`).
WHATSAPP_SENDER=recording
META_GRAPH_API_VERSION=v23.0
META_APP_SECRET=
META_VERIFY_TOKEN=local-verify-token
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Optional: lets DB-backed tests run (otherwise they are skipped).
# TEST_DATABASE_URL=postgresql+psycopg://app_rw:app_rw@localhost:5432/wa_platform
